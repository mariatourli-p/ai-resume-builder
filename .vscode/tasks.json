{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "statusbar": { "label": "$(package) Install", "color": "#61AFEF" }
      }
    },
    {
      "label": "Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "statusbar": { "label": "$(play) Dev", "color": "#98C379" } }
    },
    {
      "label": "Storybook",
      "type": "shell",
      "command": "npm run storybook",
      "options": {
        "statusbar": { "label": "$(book) Storybook", "color": "#FF4785" }
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      "options": {
        "statusbar": { "label": "$(tools) Build", "color": "#E5C07B" }
      }
    },
    {
      "label": "Build Storybook",
      "type": "shell",
      "command": "npm run build-storybook",
      "options": {
        "statusbar": { "label": "$(book) Build Storybook", "color": "#FF9F1C" }
      }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"],
      "options": {
        "statusbar": { "label": "$(search) Lint", "color": "#C678DD" }
      }
    },
    {
      "label": "Check (build + lint)",
      "dependsOrder": "sequence",
      "dependsOn": ["Build", "Lint"],
      "problemMatcher": [],
      "options": {
        "statusbar": { "label": "$(check) Check", "color": "#56B6C2" }
      }
    },
    {
      "label": "Preview",
      "type": "shell",
      "command": "npm run preview",
      "options": {
        "statusbar": { "label": "$(eye) Preview", "color": "#E06C75" }
      }
    }
  ]
}
